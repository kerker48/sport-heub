{
  "name": "sportheub",
  "version": "1.0.0",
  "description": "Sport\"heub : wiki collaboratif et anarchique sur le sport (projet R1.02)",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run db:migrate && npm run seed",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
